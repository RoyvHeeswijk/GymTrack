# Kopieer dit bestand naar .env en vul je eigen Supabase-gegevens in.
# Je vindt deze in je Supabase-dashboard onder Project Settings > API.
VITE_APP_URL=http://localhost:5173
VITE_SUPABASE_URL=https://jouw-project.supabase.co
VITE_SUPABASE_ANON_KEY=jouw-anon-key

# Optioneel: demo-account voor "Inloggen overslaan" op de auth-pagina
# VITE_DEMO_EMAIL=demo@voorbeeld.nl
# VITE_DEMO_PASSWORD=jouwwachtwoord
